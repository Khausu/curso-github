class Calculadora{

    sumar(a,b){
        return a + b;
    }

    restar(a,b){
        return a - b;
    }

    dividir(a, b){
        if(b===0){ return null }
        return a / b;
    }

    multiplicar(a,b){
        return a * b;
    }

    sumar2(a,b){
        return a+b;
    }

    potencia(a,b){
        return a ** b;
    }

    modulo(a,b){
        if(b===0){ return null }
        return a % b;
    }

    raizCuadrada(a){
        if(a<0){ return null }
        return Math.sqrt(a);
    }

    valorAbsoluto(a){
        return Math.abs(a);
    }

    promedio(...nums){
        if(nums.length===0){ return null }
        return nums.reduce((t,n) => t + n, 0) / nums.length;
    }

    porcentaje(valor,pct){
        return valor * pct / 100;
    }

    factorial(n){
        if(n<0 || !Number.isInteger(n)){ return null }
        let r = 1;
        for(let i = 2; i <= n; i++){ r *= i; }
        return r;
    }

    esPar(n){
        return n % 2 === 0;
    }

    esPrimo(n){
        if(n<2 || !Number.isInteger(n)){ return false }
        for(let i=2; i*i<=n; i++){
            if(n % i === 0){ return false }
        }
        return true;
    }

    maximo(...nums){
        if(nums.length===0){ return null }
        return Math.max(...nums);
    }

    minimo(...nums){
        if(nums.length===0){ return null }
        return Math.min(...nums);
    }

    fibonacci(n){
        if(n<0 || !Number.isInteger(n)){ return null }
        let a=0, b=1;
        for(let i=0; i<n; i++){ [a,b]=[b,a+b]; }
        return a;
    }

    mcd(a,b){
        a = Math.abs(a); b = Math.abs(b);
        while(b !== 0){
            [a, b] = [b, a % b];
        }
        return a;
    }

    mcm(a,b){
        if(a===0 || b===0){ return 0 }
        return Math.abs(a*b) / this.mcd(a,b);
    }

    redondear(n, decimales=0){
        const f = 10 ** decimales;
        return Math.round(n * f) / f;
    }

    esDivisible(a,b){
        if(b===0){ return false }
        return a % b === 0;
    }

    raizCubica(a){
        return Math.cbrt(a);
    }

    esEntero(n){
        return Number.isInteger(n);
    }

    signo(n){
        if(n>0){ return 1 }
        if(n<0){ return -1 }
        return 0;
    }

    promedioPonderado(valores, pesos){
        if(valores.length===0 || valores.length!==pesos.length){ return null }
        const sumaPesos = pesos.reduce((t,p) => t + p, 0);
        if(sumaPesos===0){ return null }
        const sumaProductos = valores.reduce((t,v,i) => t + v*pesos[i], 0);
        return sumaProductos / sumaPesos;
    }

    celsiusAFahrenheit(c){
        return c * 9/5 + 32;
    }

    fahrenheitACelsius(f){
        return (f - 32) * 5/9;
    }

    sumaDigitos(n){
        n = Math.abs(Math.trunc(n));
        let suma = 0;
        while(n > 0){
            suma += n % 10;
            n = Math.trunc(n / 10);
        }
        return suma;
    }

    esPalindromoNumerico(n){
        const texto = Math.abs(Math.trunc(n)).toString();
        return texto === texto.split("").reverse().join("");
    }

    invertirNumero(n){
        const signo = n < 0 ? -1 : 1;
        const invertido = Math.abs(Math.trunc(n)).toString().split("").reverse().join("");
        return signo * parseInt(invertido, 10);
    }

    decimalABinario(n){
        if(n < 0 || !Number.isInteger(n)){ return null }
        return n.toString(2);
    }

    binarioADecimal(bin){
        if(!/^[01]+$/.test(bin)){ return null }
        return parseInt(bin, 2);
    }

    esCuadradoPerfecto(n){
        if(n < 0 || !Number.isInteger(n)){ return false }
        const raiz = Math.sqrt(n);
        return raiz === Math.trunc(raiz);
    }

    sumaDivisores(n){
        n = Math.abs(Math.trunc(n));
        if(n === 0){ return 0 }
        let suma = 0;
        for(let i = 1; i <= n; i++){
            if(n % i === 0){ suma += i; }
        }
        return suma;
    }

    esNumeroPerfecto(n){
        if(n < 1 || !Number.isInteger(n)){ return false }
        return this.sumaDivisores(n) === n * 2;
    }

    interpolar(a, b, t){
        return a + (b - a) * t;
    }

    limitar(valor, min, max){
        if(min > max){ return null }
        return Math.min(Math.max(valor, min), max);
    }

    gradosARadianes(g){
        return g * Math.PI / 180;
    }

    radianesAGrados(r){
        return r * 180 / Math.PI;
    }

    permutaciones(n, r){
        if(n < 0 || r < 0 || r > n || !Number.isInteger(n) || !Number.isInteger(r)){ return null }
        return this.factorial(n) / this.factorial(n - r);
    }

    combinaciones(n, r){
        if(n < 0 || r < 0 || r > n || !Number.isInteger(n) || !Number.isInteger(r)){ return null }
        return this.permutaciones(n, r) / this.factorial(r);
    }

    esFibonacci(n){
        if(n < 0 || !Number.isInteger(n)){ return false }
        let a = 0, b = 1;
        while(a < n){
            [a, b] = [b, a + b];
        }
        return a === n;
    }

    hipotenusa(a, b){
        return Math.sqrt(a ** 2 + b ** 2);
    }

    areaCirculo(r){
        if(r < 0){ return null }
        return Math.PI * r ** 2;
    }

    perimetroCirculo(r){
        if(r < 0){ return null }
        return 2 * Math.PI * r;
    }

    areaRectangulo(a, b){
        if(a < 0 || b < 0){ return null }
        return a * b;
    }

    perimetroRectangulo(a, b){
        if(a < 0 || b < 0){ return null }
        return 2 * (a + b);
    }

    areaTriangulo(base, altura){
        if(base < 0 || altura < 0){ return null }
        return base * altura / 2;
    }

    perimetroTriangulo(a, b, c){
        if(a < 0 || b < 0 || c < 0){ return null }
        return a + b + c;
    }

    areaTrapecio(b1, b2, altura){
        if(b1 < 0 || b2 < 0 || altura < 0){ return null }
        return (b1 + b2) * altura / 2;
    }

    volumenCubo(lado){
        if(lado < 0){ return null }
        return lado ** 3;
    }

    volumenEsfera(r){
        if(r < 0){ return null }
        return (4/3) * Math.PI * r ** 3;
    }

    productoDigitos(n){
        n = Math.abs(Math.trunc(n));
        if(n === 0){ return 0 }
        let producto = 1;
        while(n > 0){
            producto *= n % 10;
            n = Math.trunc(n / 10);
        }
        return producto;
    }

    contarDigitos(n){
        return Math.abs(Math.trunc(n)).toString().length;
    }

    esNegativo(n){
        return n < 0;
    }

    esPositivo(n){
        return n > 0;
    }

    promedioGeometrico(...nums){
        if(nums.length === 0 || nums.some(n => n < 0)){ return null }
        const producto = nums.reduce((t, n) => t * n, 1);
        return producto ** (1 / nums.length);
    }

    sumaPares(...nums){
        return nums.filter(n => n % 2 === 0).reduce((t, n) => t + n, 0);
    }

    sumaImpares(...nums){
        return nums.filter(n => n % 2 !== 0).reduce((t, n) => t + n, 0);
    }

    varianza(...nums){
        if(nums.length === 0){ return null }
        const media = this.promedio(...nums);
        return nums.reduce((t, n) => t + (n - media) ** 2, 0) / nums.length;
    }

    desviacionEstandar(...nums){
        const v = this.varianza(...nums);
        return v === null ? null : Math.sqrt(v);
    }

    esArmstrong(n){
        if(n < 0 || !Number.isInteger(n)){ return false }
        const digitos = n.toString().split("");
        const potencia = digitos.length;
        const suma = digitos.reduce((t, d) => t + Number(d) ** potencia, 0);
        return suma === n;
    }

    raizN(a, n){
        if(n === 0){ return null }
        if(a < 0 && n % 2 === 0){ return null }
        const signo = a < 0 ? -1 : 1;
        return signo * Math.abs(a) ** (1 / n);
    }

    logaritmo(a, base){
        if(a <= 0 || base <= 0 || base === 1){ return null }
        return Math.log(a) / Math.log(base);
    }

    esPotenciaDe(n, base){
        if(n <= 0 || base <= 1 || !Number.isInteger(n) || !Number.isInteger(base)){ return false }
        while(n % base === 0){
            n = n / base;
        }
        return n === 1;
    }

    diferenciaPorcentual(a, b){
        if(a === 0){ return null }
        return (b - a) / Math.abs(a) * 100;
    }

    normalizar(valor, min, max){
        if(min === max){ return null }
        return (valor - min) / (max - min);
    }

    numeroTriangular(n){
        if(n < 0 || !Number.isInteger(n)){ return null }
        return n * (n + 1) / 2;
    }

    esTriangular(n){
        if(n < 0 || !Number.isInteger(n)){ return false }
        const raiz = (Math.sqrt(8 * n + 1) - 1) / 2;
        return raiz === Math.trunc(raiz);
    }

    mediana(...nums){
        if(nums.length === 0){ return null }
        const ordenados = [...nums].sort((a, b) => a - b);
        const mitad = Math.floor(ordenados.length / 2);
        if(ordenados.length % 2 === 0){
            return (ordenados[mitad - 1] + ordenados[mitad]) / 2;
        }
        return ordenados[mitad];
    }

    moda(...nums){
        if(nums.length === 0){ return null }
        const conteo = new Map();
        for(const n of nums){ conteo.set(n, (conteo.get(n) || 0) + 1); }
        let maxConteo = 0, resultado = [];
        for(const [valor, veces] of conteo){
            if(veces > maxConteo){ maxConteo = veces; resultado = [valor]; }
            else if(veces === maxConteo){ resultado.push(valor); }
        }
        return resultado;
    }

    rangoNumeros(...nums){
        if(nums.length === 0){ return null }
        return this.maximo(...nums) - this.minimo(...nums);
    }

    sumaRango(a, b){
        if(!Number.isInteger(a) || !Number.isInteger(b) || a > b){ return null }
        return (b - a + 1) * (a + b) / 2;
    }

    productoRango(a, b){
        if(!Number.isInteger(a) || !Number.isInteger(b) || a > b){ return null }
        let producto = 1;
        for(let i = a; i <= b; i++){ producto *= i; }
        return producto;
    }

    esMultiploComun(n, a, b){
        return this.esDivisible(n, a) && this.esDivisible(n, b);
    }

    esNumeroFeliz(n){
        if(n < 1 || !Number.isInteger(n)){ return false }
        const vistos = new Set();
        while(n !== 1 && !vistos.has(n)){
            vistos.add(n);
            n = n.toString().split("").reduce((t, d) => t + Number(d) ** 2, 0);
        }
        return n === 1;
    }

    esPalindromoBinario(n){
        const bin = this.decimalABinario(n);
        return bin !== null && bin === bin.split("").reverse().join("");
    }

    distanciaEuclidiana(x1, y1, x2, y2){
        return Math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2);
    }

    magnitudVector(x, y){
        return Math.sqrt(x ** 2 + y ** 2);
    }

    productoEscalar(a, b){
        if(a.length !== b.length){ return null }
        return a.reduce((t, v, i) => t + v * b[i], 0);
    }
}
