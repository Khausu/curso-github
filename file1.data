class Calculadora{

    sumar(a,b){
        return a + b;
    }

    restar(a,b){
        return a - b;
    }

    dividir(a, b){
        if(b===0){ return null }
        return a / b;
    }

    multiplicar(a,b){
        return a * b;
    }

    sumar2(a,b){
        return a+b;
    }

    potencia(a,b){
        return a ** b;
    }

    modulo(a,b){
        if(b===0){ return null }
        return a % b;
    }

    raizCuadrada(a){
        if(a<0){ return null }
        return Math.sqrt(a);
    }

    valorAbsoluto(a){
        return Math.abs(a);
    }

    promedio(...nums){
        if(nums.length===0){ return null }
        return nums.reduce((t,n) => t + n, 0) / nums.length;
    }

    porcentaje(valor,pct){
        return valor * pct / 100;
    }

    factorial(n){
        if(n<0 || !Number.isInteger(n)){ return null }
        let r = 1;
        for(let i = 2; i <= n; i++){ r *= i; }
        return r;
    }

    esPar(n){
        return n % 2 === 0;
    }

    esPrimo(n){
        if(n<2 || !Number.isInteger(n)){ return false }
        for(let i=2; i*i<=n; i++){
            if(n % i === 0){ return false }
        }
        return true;
    }

    maximo(...nums){
        if(nums.length===0){ return null }
        return Math.max(...nums);
    }

    minimo(...nums){
        if(nums.length===0){ return null }
        return Math.min(...nums);
    }
}
