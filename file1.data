class Calculadora{

    sumar(a,b){
        return a + b;
    }

    restar(a,b){
        return a - b;
    }

    dividir(a, b){
        if(b===0){ return null }
        return a / b;
    }

    multiplicar(a,b){
        return a * b;
    }

    sumar2(a,b){
        return a+b;
    }

    potencia(a,b){
        return a ** b;
    }

    modulo(a,b){
        if(b===0){ return null }
        return a % b;
    }

    raizCuadrada(a){
        if(a<0){ return null }
        return Math.sqrt(a);
    }

    valorAbsoluto(a){
        return Math.abs(a);
    }
}
