class Test {

    constructor(){
        this.calc = new Calculadora();
    }

    probarSumar(){
        return this.calc.sumar(2, 3) === 5;
    }

    probarDividirEntreCero(){
        return this.calc.dividir(5, 0) === null;
    }

    probarRestar(){
        return this.calc.restar(10, 4) === 6;
    }

    probarMultiplicar(){
        return this.calc.multiplicar(3, 4) === 12;
    }

    probarPotencia(){
        return this.calc.potencia(2, 10) === 1024;
    }

    probarModuloEntreCero(){
        return this.calc.modulo(7, 0) === null;
    }

    probarRaizCuadradaNegativa(){
        return this.calc.raizCuadrada(-9) === null;
    }

    probarPromedio(){
        return this.calc.promedio(2, 4, 6) === 4;
    }

    probarPorcentaje(){
        return this.calc.porcentaje(200, 15) === 30;
    }

    probarFactorial(){
        return this.calc.factorial(5) === 120 && this.calc.factorial(-1) === null;
    }

    probarEsPar(){
        return this.calc.esPar(8) === true && this.calc.esPar(7) === false;
    }

    probarEsPrimo(){
        return this.calc.esPrimo(13) === true && this.calc.esPrimo(12) === false;
    }

    probarMaximo(){
        return this.calc.maximo(3, 7, 1) === 7;
    }

    probarMinimo(){
        return this.calc.minimo(3, 7, 1) === 1;
    }

    probarFibonacci(){
        return this.calc.fibonacci(10) === 55;
    }

    probarMcd(){
        return this.calc.mcd(12, 18) === 6;
    }

    probarMcm(){
        return this.calc.mcm(4, 6) === 12;
    }

    probarRedondear(){
        return this.calc.redondear(3.14159, 2) === 3.14;
    }

    probarEsDivisible(){
        return this.calc.esDivisible(10, 5) === true && this.calc.esDivisible(10, 3) === false;
    }

    probarRaizCubica(){
        return this.calc.raizCubica(27) === 3;
    }

    probarEsEntero(){
        return this.calc.esEntero(4) === true && this.calc.esEntero(4.5) === false;
    }

    probarSigno(){
        return this.calc.signo(-5) === -1 && this.calc.signo(5) === 1 && this.calc.signo(0) === 0;
    }

    probarPromedioPonderado(){
        return this.calc.promedioPonderado([80, 90], [1, 3]) === 87.5;
    }
}
